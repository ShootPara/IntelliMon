<Window x:Class="IntelliMon.App.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IntelliMon.App.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IntelliMon"
        Width="340"
        Opacity="0"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Converters -->
        <local:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>

        <!-- Color brushes -->
        <SolidColorBrush x:Key="BackgroundBrush"    Color="#CC1E1E2E"/>
        <SolidColorBrush x:Key="AccentBrush"         Color="#6C8EFF"/>
        <SolidColorBrush x:Key="QuietAccentBrush"    Color="#4CAF50"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#F0F0F0"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#A0A0B0"/>
        <SolidColorBrush x:Key="BorderBrush"         Color="#3A3A5C"/>
        <SolidColorBrush x:Key="CardBrush"           Color="#1A1A30"/>

        <!-- Metric pill base style -->
        <Style x:Key="MetricPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="#2A2A45"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
        </Style>
    </Window.Resources>

    <!-- Outer drag handle -->
    <Border x:Name="RootBorder"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Grid Grid.Row="0" Margin="12,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot"
                         Width="8" Height="8"
                         VerticalAlignment="Center"
                         Fill="{StaticResource AccentBrush}"
                         Margin="0,0,6,0"/>

                <TextBlock Grid.Column="1"
                           Text="IntelliMon AI"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>

                <Button x:Name="PinButton"
                        Grid.Column="2"
                        Content="📌"
                        FontSize="11"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Cursor="Hand"
                        Padding="4,0"
                        Click="PinButton_Click"
                        ToolTip="Pin overlay (keep on top)"/>
            </Grid>

            <!-- Process card -->
            <Border Grid.Row="1"
                    Margin="10,2,10,10"
                    Padding="12,10,12,10"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="8">
                <StackPanel>

                    <!-- Display name -->
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,2"/>

                    <!-- Process name + category sub-line -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ProcessName}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" · "
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Category}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Resource metric pills (only shown when > 0) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource MetricPill}"
                                Visibility="{Binding CpuPercent, Converter={StaticResource GreaterThanZeroConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:F1}%}"
                                           Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricPill}"
                                Visibility="{Binding MemoryPercent, Converter={StaticResource GreaterThanZeroConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RAM" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding MemoryPercent, StringFormat={}{0:F1}%}"
                                           Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricPill}"
                                Visibility="{Binding DiskPercent, Converter={StaticResource GreaterThanZeroConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Disk" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding DiskPercent, StringFormat={}{0:F1}%}"
                                           Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Summary -->
                    <TextBlock Text="{Binding Summary}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxHeight="70"
                               LineHeight="16"/>

                    <!-- Publisher footer -->
                    <TextBlock Text="{Binding Publisher}"
                               Foreground="#606080"
                               FontSize="9"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
